# Copia este archivo a .env y rellena los valores reales.
# NUNCA pongas credenciales reales aquí — .env.example SÍ se versiona.

# Conexión a Postgres. En Neon: Dashboard → Connection string.
DATABASE_URL="postgresql://usuario:password@host:5432/durango?sslmode=require"

# Base para construir la URL pública de cada PDF a partir de pdfPath (relativo tras /transparencia/).
PDF_BASE_URL="http://pjdgo.gob.mx/transparencia/"
